@startuml Figure_4_3_2_UC10_Modified_Sequence_Diagram
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Calibri"
skinparam defaultFontSize 11
skinparam defaultFontColor #000000
skinparam linetype ortho
skinparam roundCorner 0
hide circle

actor "Shipper" as S
boundary "ShipperMobileUI\n(View Layer)" as UI
control "DeliveryController\n(Controller Layer)" as Ctrl
entity "DeliveryTask\n(Domain Entity)" as Task
entity "Order\n(Domain Entity)" as Ord
entity "Payment\n(Domain Entity)" as Pay
control "DeliveryTaskDAO\n(Data Access Layer)" as TaskDAO
control "OrderDAO\n(Data Access Layer)" as OrderDAO
control "AuditLogDAO\n(Data Access Layer)" as AuditDAO
database "SQLite Database\n(saigonbite_db)" as DB

== Phase 1: Hub Parcel QR Scanning & Pickup ==
S -> UI: 1. onScanPickupQRClicked(orderId, qrToken)
activate UI
UI -> Ctrl: 1.1 processPickupScan(orderId, qrToken)
activate Ctrl

Ctrl -> TaskDAO: 1.2 findByOrderId(orderId)
activate TaskDAO
TaskDAO -> DB: 1.3 SELECT * FROM delivery_tasks WHERE order_id = ?
activate DB
DB --> TaskDAO: taskRow
deactivate DB
TaskDAO --> Ctrl: task: DeliveryTask
deactivate TaskDAO

Ctrl -> Task: 1.4 updatePickupStatus(timestamp)
activate Task
Task --> Ctrl: success: true
deactivate Task

Ctrl -> TaskDAO: 1.5 update(task)
activate TaskDAO
TaskDAO -> DB: 1.6 UPDATE delivery_tasks SET delivery_status='Picked_Up', picked_up_at=?
activate DB
DB --> TaskDAO: ok
deactivate DB
deactivate TaskDAO

Ctrl -> OrderDAO: 1.7 updateStatus(orderId, "Out_for_Delivery")
activate OrderDAO
OrderDAO -> DB: 1.8 UPDATE orders SET order_status='Out_for_Delivery' WHERE order_id=?
activate DB
DB --> OrderDAO: ok
deactivate DB
deactivate OrderDAO

Ctrl -> AuditDAO: 1.9 recordAuditEntry(orderId, "Shipper", "SCAN_PICKUP_SUCCESS")
activate AuditDAO
AuditDAO -> DB: 1.10 INSERT INTO audit_logs VALUES (...)
activate DB
DB --> AuditDAO: ok
deactivate DB
deactivate AuditDAO

Ctrl --> UI: 1.11 return {success: true, status: 'Out_for_Delivery'}
deactivate Ctrl
UI --> S: 1.12 displayNavigationMapAndDeliveryScreen()
deactivate UI

== Phase 2: Doorstep Drop-off (Alternative Flow: Success vs 10-Minute Timeout) ==
alt [Normal Flow: Customer Accepts Food & Pays COD Cash]
    S -> UI: 2a. onConfirmDeliveryClicked(orderId, codAmount, photoUrl)
    activate UI
    UI -> Ctrl: 2a.1 recordDeliverySuccess(orderId, codAmount, photoUrl)
    activate Ctrl

    Ctrl -> TaskDAO: 2a.2 findByOrderId(orderId)
    activate TaskDAO
    TaskDAO --> Ctrl: taskObj
    deactivate TaskDAO

    Ctrl -> Task: 2a.3 completeDelivery(codAmount, photoUrl)
    activate Task
    Task --> Ctrl: success
    deactivate Task

    Ctrl -> Ord: 2a.4 updateStatus("Delivered")
    activate Ord
    Ord --> Ctrl: success
    deactivate Ord

    Ctrl -> Pay: 2a.5 confirmCODPayment(codAmount)
    activate Pay
    Pay --> Ctrl: success
    deactivate Pay

    Ctrl -> TaskDAO: 2a.6 update(taskObj)
    activate TaskDAO
    TaskDAO -> DB: 2a.7 UPDATE delivery_tasks SET delivery_status='Delivered', cod_collected_vnd=? ...
    activate DB
    DB --> TaskDAO: ok
    deactivate DB
    deactivate TaskDAO

    Ctrl -> OrderDAO: 2a.8 updateStatus(orderId, "Delivered")
    activate OrderDAO
    OrderDAO -> DB: 2a.9 UPDATE orders SET order_status='Delivered', delivered_at=? ...
    activate DB
    DB --> OrderDAO: ok
    deactivate DB
    deactivate OrderDAO

    Ctrl -> AuditDAO: 2a.10 recordAuditEntry(orderId, "Shipper", "DELIVERY_SUCCESS_COD_RECONCILED")
    activate AuditDAO
    AuditDAO -> DB: 2a.11 INSERT INTO audit_logs VALUES (...)
    activate DB
    DB --> AuditDAO: ok
    deactivate DB
    deactivate AuditDAO

    Ctrl --> UI: 2a.12 return {success: true, message: 'Delivered & COD Collected'}
    deactivate Ctrl
    UI --> S: 2a.13 displayDeliverySuccessAndCreditedWallet(+20,000 VND)
    deactivate UI

else [Exception Flow: Customer Unreachable After 3 Calls & 10-Min Countdown Expiry]
    S -> UI: 2b. onReportFailureClicked(orderId, "Customer unreachable after 10m countdown", photoUrl)
    activate UI
    UI -> Ctrl: 2b.1 recordDeliveryFailure(orderId, reason, photoUrl)
    activate Ctrl

    Ctrl -> TaskDAO: 2b.2 findByOrderId(orderId)
    activate TaskDAO
    TaskDAO --> Ctrl: taskObj
    deactivate TaskDAO

    Ctrl -> Task: 2b.3 markFailed(reason, photoUrl)
    activate Task
    Task --> Ctrl: success
    deactivate Task

    Ctrl -> Ord: 2b.4 updateStatus("Delivery_Failed")
    activate Ord
    Ord --> Ctrl: success
    deactivate Ord

    Ctrl -> TaskDAO: 2b.5 update(taskObj)
    activate TaskDAO
    TaskDAO -> DB: 2b.6 UPDATE delivery_tasks SET delivery_status='Failed_Returned', failure_reason=? ...
    activate DB
    DB --> TaskDAO: ok
    deactivate DB
    deactivate TaskDAO

    Ctrl -> OrderDAO: 2b.7 updateStatus(orderId, "Delivery_Failed")
    activate OrderDAO
    OrderDAO -> DB: 2b.8 UPDATE orders SET order_status='Delivery_Failed', cancellation_reason=? ...
    activate DB
    DB --> OrderDAO: ok
    deactivate DB
    deactivate OrderDAO

    Ctrl -> AuditDAO: 2b.9 recordAuditEntry(orderId, "Shipper", "DELIVERY_FAILED_10MIN_TIMEOUT")
    activate AuditDAO
    AuditDAO -> DB: 2b.10 INSERT INTO audit_logs VALUES (...)
    activate DB
    DB --> AuditDAO: ok
    deactivate DB
    deactivate AuditDAO

    Ctrl --> UI: 2b.11 return {success: true, returnManifestCreated: true}
    deactivate Ctrl
    UI --> S: 2b.12 displayReturnParcelToHubManifest()
    deactivate UI
end

@enduml
