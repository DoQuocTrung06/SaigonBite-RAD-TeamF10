@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000
skinparam ParticipantFontSize 9
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 9

right header 524H0136

actor "Shipper" as Shipper
participant "<<view>>\n__:ShipperMobileUI__" as UI
participant "<<controller>>\n__:DeliveryController__" as Ctrl
participant "__aDT:DeliveryTask__" as Task
participant "<<dataAccess>>\n__:DeliveryTaskDAO__" as TaskDAO
participant "__aO:Order__" as Ord
participant "<<dataAccess>>\n__:OrderDAO__" as OrderDAO
participant "__aP:Payment__" as Pay
participant "<<dataAccess>>\n__:AuditLogDAO__" as AuditDAO

Shipper -> UI: onScanPickupQRClicked(orderId, qrCode)
activate UI
UI -> Ctrl: processPickupScan(orderId, qrCode)
activate Ctrl
Ctrl -> TaskDAO: findByOrderId(orderId)
activate TaskDAO
TaskDAO --> Ctrl: aDT
deactivate TaskDAO
Ctrl -> Task: updatePickupStatus(timestamp)
activate Task
Task -> TaskDAO: update(aDT)
activate TaskDAO
TaskDAO --> Task: updated
deactivate TaskDAO
Task --> Ctrl: statusPickedUp
deactivate Task
Ctrl -> Ord: updateStatus("Delivering")
activate Ord
Ord -> OrderDAO: updateStatus(orderId, "Delivering")
activate OrderDAO
OrderDAO --> Ord: updated
deactivate OrderDAO
Ord --> Ctrl: statusDelivering
deactivate Ord
Ctrl -> AuditDAO: recordAuditEntry(orderId, "Shipper", "SCAN_PICKUP_SUCCESS")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: pickup confirmed, route loaded
deactivate Ctrl
UI --> Shipper: displayAssignedTrip(routeDetails)
deactivate UI

Shipper -> UI: onConfirmDeliveryClicked(orderId, codAmount, photoUrl)
activate UI
UI -> Ctrl: recordDeliverySuccess(orderId, codAmount, photoUrl)
activate Ctrl
Ctrl -> Pay: [COD order] confirmCODPayment(codAmount)
activate Pay
Pay --> Ctrl: paymentReconciled
deactivate Pay
Ctrl -> Task: completeDelivery(codAmount, photoUrl)
activate Task
Task -> TaskDAO: update(aDT)
activate TaskDAO
TaskDAO --> Task: updated
deactivate TaskDAO
Task --> Ctrl: taskCompleted
deactivate Task
Ctrl -> Ord: updateStatus("Delivered")
activate Ord
Ord -> OrderDAO: updateStatus(orderId, "Delivered")
activate OrderDAO
OrderDAO --> Ord: updated
deactivate OrderDAO
Ord --> Ctrl: statusDelivered
deactivate Ord
Ctrl -> AuditDAO: recordAuditEntry(orderId, "Shipper", "DELIVERY_SUCCESS_COD_RECONCILED")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: delivery completed, state Delivered
deactivate Ctrl
UI --> Shipper: delivery confirmation
deactivate UI
@enduml
