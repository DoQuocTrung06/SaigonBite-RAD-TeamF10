@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000
skinparam ParticipantFontSize 9
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 9

right header 524H0132

actor "Kitchen Staff" as Staff
participant "<<view>>\n__:KDSConsoleUI__" as UI
participant "<<controller>>\n__:KitchenController__" as Ctrl
participant "__aO:Order__" as Ord
participant "<<dataAccess>>\n__:OrderDAO__" as OrderDAO
participant "__aH:Hub__" as Hub
participant "<<dataAccess>>\n__:HubDAO__" as HubDAO
participant "__aKT:KitchenTicket__" as Ticket
participant "<<dataAccess>>\n__:KitchenTicketDAO__" as TicketDAO
participant "<<dataAccess>>\n__:AuditLogDAO__" as AuditDAO

Staff -> UI: confirmOrder(orderId, stationId, elapsedSeconds)
activate UI
UI -> Ctrl: confirmOrder(orderId, stationId, elapsedSeconds)
activate Ctrl
Ctrl -> OrderDAO: findById(orderId)
activate OrderDAO
OrderDAO --> Ctrl: aO
deactivate OrderDAO
Ctrl -> HubDAO: findById(hubId)
activate HubDAO
HubDAO --> Ctrl: aH
deactivate HubDAO
Ctrl -> Hub: isOverloaded()
activate Hub
Hub --> Ctrl: isBusy (< 85%)
deactivate Hub
Ctrl -> Ord: [elapsedSeconds <= 120] updateStatus("Confirmed")
activate Ord
Ord -> OrderDAO: updateStatus(orderId, "Confirmed")
activate OrderDAO
OrderDAO --> Ord: updated (isLocked = true)
deactivate OrderDAO
Ord --> Ctrl: statusConfirmed
deactivate Ord
Ctrl -> Ticket: createStationTicket(stationId)
activate Ticket
Ticket -> TicketDAO: save(aKT)
activate TicketDAO
TicketDAO --> Ticket: ticketSaved
deactivate TicketDAO
Ticket --> Ctrl: aKT
deactivate Ticket
Ctrl -> AuditDAO: recordAuditEntry(orderId, "KitchenStaff", "ORDER_CONFIRMED_AND_LOCKED")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: confirmed, address locked, ticket queued
deactivate Ctrl
UI --> Staff: displayOrderConfirmation(orderId, true, true)
deactivate UI

Staff -> UI: [reject order] rejectOrder(orderId, reason)
activate UI
UI -> Ctrl: rejectOrder(orderId, reason)
activate Ctrl
Ctrl -> Ord: updateStatus("Cancelled", reason)
activate Ord
Ord -> OrderDAO: updateStatus(orderId, "Cancelled", reason)
activate OrderDAO
OrderDAO --> Ord: updated
deactivate OrderDAO
Ord --> Ctrl: statusCancelled
deactivate Ord
Ctrl -> AuditDAO: recordAuditEntry(orderId, "KitchenStaff", "ORDER_REJECTED_REFUND_TRIGGERED")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: order cancelled, refund triggered
deactivate Ctrl
UI --> Staff: displayOrderRejection(orderId, reason, true)
deactivate UI
@enduml
