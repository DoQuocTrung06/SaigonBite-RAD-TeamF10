@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000
skinparam ParticipantFontSize 9
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 9

right header 524H0132

actor "Administrator" as Admin
participant "<<view>>\n__:VoucherConsoleUI__" as UI
participant "<<controller>>\n__:VoucherController__" as Ctrl
participant "__aV:Voucher__" as Vch
participant "<<dataAccess>>\n__:VoucherDAO__" as VDAO
participant "<<dataAccess>>\n__:AuditLogDAO__" as AuditDAO

Admin -> UI: createVoucher(code, discountPercent, maxDiscount, minOrder, start, end, quota)
activate UI
UI -> Ctrl: createVoucher(code, discountPercent, maxDiscount, minOrder, start, end, quota)
activate Ctrl
Ctrl -> VDAO: findByCode(code)
activate VDAO
VDAO --> Ctrl: null
deactivate VDAO
Ctrl -> Vch: validate()
activate Vch
Vch --> Ctrl: valid = true
deactivate Vch
Ctrl -> VDAO: [valid] save(aV)
activate VDAO
VDAO --> Ctrl: saved = true
deactivate VDAO
Ctrl -> AuditDAO: recordAuditEntry(code, "Administrator", "CREATE_VOUCHER")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: confirmation, state Active
deactivate Ctrl
UI --> Admin: displayCreateResult(code, true)
deactivate UI

Admin -> UI: [archive voucher] archiveVoucher(code)
activate UI
UI -> Ctrl: archiveVoucher(code)
activate Ctrl
Ctrl -> VDAO: findByCode(code)
activate VDAO
VDAO --> Ctrl: aV
deactivate VDAO
Ctrl -> Vch: archive()
activate Vch
Vch --> Ctrl: state Archived
deactivate Vch
Ctrl -> VDAO: update(aV)
activate VDAO
VDAO --> Ctrl: updated = true
deactivate VDAO
Ctrl -> AuditDAO: recordAuditEntry(code, "Administrator", "ARCHIVE_VOUCHER")
activate AuditDAO
AuditDAO --> Ctrl: logged
deactivate AuditDAO
Ctrl --> UI: confirmation, state Archived
deactivate Ctrl
UI --> Admin: displayArchiveResult(code, true)
deactivate UI
@enduml
