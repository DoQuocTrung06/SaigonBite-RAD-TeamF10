@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 0
skinparam dpi 160
skinparam PackageStyle folder
skinparam nodesep 22
skinparam ranksep 28

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold

skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #000000
skinparam PackageBorderThickness 1.4
skinparam PackageFontColor #000000
skinparam PackageFontSize 12
skinparam PackageFontStyle bold

skinparam ArrowColor #000000
skinparam ArrowThickness 1.2

hide circle
hide members
top to bottom direction
right header 524H0136, 524H0031, 524H0132

package "View Layer" as ViewLayer {
  class CheckoutWindow
  class BrandCatalogWindow
  class VoucherConsoleUI
  class KDSConsoleUI
  class ShipperMobileUI
  class ReportConsoleUI

  CheckoutWindow -[hidden]right-> BrandCatalogWindow
  BrandCatalogWindow -[hidden]right-> VoucherConsoleUI
  CheckoutWindow -[hidden]down-> KDSConsoleUI
  BrandCatalogWindow -[hidden]down-> ShipperMobileUI
  VoucherConsoleUI -[hidden]down-> ReportConsoleUI
}

package "Domain Layer" as DomainLayer {
  class OrderHandler
  class BrandCatalogHandler
  class VoucherController
  class KitchenController
  class DeliveryController
  class ReportController

  class Customer
  class LocalCustomer
  class ForeignTourist
  class Brand
  class MenuItem
  class Hub
  class KitchenStation
  class Order
  class OrderLine
  class Voucher
  class Payment
  class KitchenTicket
  class Shipper
  class DeliveryTask
  class ManagementReport

  OrderHandler -[hidden]right-> BrandCatalogHandler
  BrandCatalogHandler -[hidden]right-> VoucherController
  VoucherController -[hidden]right-> KitchenController
  KitchenController -[hidden]right-> DeliveryController
  DeliveryController -[hidden]right-> ReportController

  OrderHandler -[hidden]down-> Customer
  BrandCatalogHandler -[hidden]down-> Brand
  VoucherController -[hidden]down-> Hub
  KitchenController -[hidden]down-> Order
  DeliveryController -[hidden]down-> Voucher
  ReportController -[hidden]down-> Payment

  Customer -[hidden]down-> LocalCustomer
  Brand -[hidden]down-> ForeignTourist
  Hub -[hidden]down-> MenuItem
  Order -[hidden]down-> KitchenStation
  Voucher -[hidden]down-> OrderLine
  Payment -[hidden]down-> KitchenTicket

  LocalCustomer -[hidden]down-> Shipper
  ForeignTourist -[hidden]down-> DeliveryTask
  MenuItem -[hidden]down-> ManagementReport
}

package "Data Access Layer" as DALayer {
  class OrderDA
  class BrandDA
  class MenuItemDA
  class HubDA
  class VoucherDA
  class PaymentDA
  class KitchenTicketDAO
  class DeliveryTaskDAO
  class ReportDAO
  class AuditLogDAO

  OrderDA -[hidden]right-> BrandDA
  BrandDA -[hidden]right-> MenuItemDA
  MenuItemDA -[hidden]right-> HubDA
  HubDA -[hidden]right-> VoucherDA

  OrderDA -[hidden]down-> PaymentDA
  BrandDA -[hidden]down-> KitchenTicketDAO
  MenuItemDA -[hidden]down-> DeliveryTaskDAO
  HubDA -[hidden]down-> ReportDAO
  VoucherDA -[hidden]down-> AuditLogDAO
}

ViewLayer -down..> DomainLayer
DomainLayer -down..> DALayer
Shipper -[hidden]down-> OrderDA
DeliveryTask -[hidden]down-> BrandDA
ManagementReport -[hidden]down-> MenuItemDA
@enduml
