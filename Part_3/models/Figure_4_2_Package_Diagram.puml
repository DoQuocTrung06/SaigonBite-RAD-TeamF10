@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 0
skinparam dpi 160
skinparam PackageStyle folder
skinparam nodesep 36
skinparam ranksep 52

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold

skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #000000
skinparam PackageBorderThickness 1.4
skinparam PackageFontColor #000000
skinparam PackageFontSize 12
skinparam PackageFontStyle bold

skinparam ArrowColor #000000
skinparam ArrowThickness 1.2

hide circle
hide members
top to bottom direction
right header 524H0136, 524H0031, 524H0132

package "View Layer" as ViewLayer {
  class CheckoutWindow
  class BrandCatalogWindow
  class VoucherConsoleUI
  class KDSConsoleUI
  class ShipperMobileUI
  class ReportConsoleUI
}

package "Domain Layer" as DomainLayer {
  class OrderHandler <<controller>>
  class BrandCatalogHandler <<controller>>
  class VoucherController <<controller>>
  class KitchenController <<controller>>
  class DeliveryController <<controller>>
  class ReportController <<controller>>

  class Customer
  class LocalCustomer
  class ForeignTourist
  class Hub
  class KitchenStation
  class Brand
  class MenuItem
  class Order
  class OrderLine
  class Voucher
  class Payment
  class KitchenTicket
  class Shipper
  class DeliveryTask
  class ManagementReport

  OrderHandler -[hidden]down-> Customer
  BrandCatalogHandler -[hidden]down-> Brand
  VoucherController -[hidden]down-> Voucher
  KitchenController -[hidden]down-> Hub
  DeliveryController -[hidden]down-> DeliveryTask
  ReportController -[hidden]down-> ManagementReport

  Customer -[hidden]down-> LocalCustomer
  LocalCustomer -[hidden]right-> ForeignTourist
  Brand -[hidden]down-> MenuItem
  Hub -[hidden]down-> KitchenStation
  Voucher -[hidden]down-> Order
  Order -[hidden]right-> OrderLine
  DeliveryTask -[hidden]down-> Payment
  ManagementReport -[hidden]down-> KitchenTicket
  KitchenTicket -[hidden]right-> Shipper
}

package "Data Access Layer" as DALayer {
  class OrderDA
  class BrandDA
  class MenuItemDA
  class HubDA
  class VoucherDA
  class PaymentDA
  class KitchenTicketDAO
  class DeliveryTaskDAO
  class ReportDAO
  class AuditLogDAO
}

ViewLayer ..> DomainLayer
DomainLayer ..> DALayer
@enduml
