@startuml Figure_4_3_2_UC15_Modified_Sequence_Diagram
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Calibri"
skinparam defaultFontSize 11
skinparam defaultFontColor #000000
skinparam linetype ortho
skinparam roundCorner 0
hide circle

actor "Administrator" as Admin
boundary "VoucherConsoleUI\n(View Layer)" as UI
control "VoucherController\n(Controller Layer)" as Ctrl
entity "Voucher\n(Domain Entity)" as Vch
control "VoucherDAO\n(Data Access Layer)" as VDAO
control "AuditLogDAO\n(Data Access Layer)" as AuditDAO
database "Relational Database\n(saigonbite_db)" as DB

== Phase 1: Create Promotional Voucher ==
Admin -> UI: 1. submitNewVoucherForm(code, discountPercent, maxDiscount, minOrder, dates, quota)
activate UI
UI -> Ctrl: 1.1 CreateVoucher(code, discountPercent, maxDiscount, minOrder, start, end, quota)
activate Ctrl

Ctrl -> VDAO: 1.2 FindByCode(code)
activate VDAO
VDAO -> DB: 1.3 SELECT * FROM vouchers WHERE voucher_code = ?
activate DB
DB --> VDAO: null (unique)
deactivate DB
VDAO --> Ctrl: null
deactivate VDAO

Ctrl -> Vch: 1.4 new Voucher() & Validate()
activate Vch
Vch --> Ctrl: valid = true
deactivate Vch

Ctrl -> VDAO: 1.5 Save(voucher)
activate VDAO
VDAO -> DB: 1.6 INSERT INTO vouchers (...) VALUES (...)
activate DB
DB --> VDAO: 1 row inserted
deactivate DB
VDAO --> Ctrl: true
deactivate VDAO

Ctrl -> AuditDAO: 1.7 RecordAuditEntry(code, "Administrator", "CREATE_VOUCHER")
activate AuditDAO
AuditDAO -> DB: 1.8 INSERT INTO audit_logs (...) VALUES (...)
activate DB
DB --> AuditDAO: ok (< 1s NFR5)
deactivate DB
deactivate AuditDAO

Ctrl --> UI: true
deactivate Ctrl
UI --> Admin: 1.9 DisplayCreateResult(code, true)
deactivate UI

== Phase 2: Archive Voucher (Soft Delete) ==
Admin -> UI: 2. clickArchiveVoucher(code)
activate UI
UI -> Ctrl: 2.1 ArchiveVoucher(code)
activate Ctrl

Ctrl -> VDAO: 2.2 FindByCode(code)
activate VDAO
VDAO -> DB: 2.3 SELECT * FROM vouchers WHERE voucher_code = ?
activate DB
DB --> VDAO: voucherRow
deactivate DB
VDAO --> Ctrl: voucher: Voucher
deactivate VDAO

Ctrl -> Vch: 2.4 Archive()
activate Vch
Vch --> Ctrl: Status = "Archived"
deactivate Vch

Ctrl -> VDAO: 2.5 Update(voucher)
activate VDAO
VDAO -> DB: 2.6 UPDATE vouchers SET status = 'Archived' WHERE voucher_code = ?
activate DB
DB --> VDAO: ok
deactivate DB
deactivate VDAO

Ctrl -> AuditDAO: 2.7 RecordAuditEntry(code, "Administrator", "ARCHIVE_VOUCHER")
activate AuditDAO
AuditDAO -> DB: 2.8 INSERT INTO audit_logs (...) VALUES (...)
activate DB
DB --> AuditDAO: ok
deactivate DB
deactivate AuditDAO

Ctrl --> UI: true
deactivate Ctrl
UI --> Admin: 2.9 DisplayArchiveResult(code, true)
deactivate UI

@enduml
