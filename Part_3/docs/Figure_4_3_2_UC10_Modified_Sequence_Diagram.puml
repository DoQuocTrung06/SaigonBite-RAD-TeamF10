@startuml Figure_4_3_2_UC10_Modified_Sequence_Diagram
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Calibri"
skinparam defaultFontSize 11
skinparam defaultFontColor #000000
skinparam linetype ortho
skinparam roundCorner 0
hide circle

actor "Shipper" as S
boundary "ShipperView\n(Mobile App)" as V
control "DeliveryController" as C
entity "DeliveryTask" as DT
entity "Order" as O
entity "Shipper" as SH
control "DeliveryRepository" as R
database "SQLite Database\n(saigonbite_db)" as DB

== Phase 1: Hub Pickup & QR Verification ==
S -> V: 1. scanPackageQR(taskId, qrToken)
activate V
V -> C: 1.1 scanPackageQR(taskId, qrToken)
activate C
C -> R: 1.2 getTaskById(taskId)
activate R
R -> DB: 1.3 SELECT * FROM delivery_tasks WHERE task_id = ?
activate DB
DB --> R: task_row
deactivate DB
R --> C: task: DeliveryTask
deactivate R

C -> DT: 1.4 scanQRAndPickup(qrToken)
activate DT
DT --> C: success: true
deactivate DT

C -> R: 1.5 saveTask(task)
activate R
R -> DB: 1.6 UPDATE delivery_tasks SET task_status = 'Picked_Up' ...
activate DB
DB --> R: ok
deactivate DB
deactivate R

C -> R: 1.7 updateOrderStatus(orderId, 'Out_for_Delivery')
activate R
R -> DB: 1.8 UPDATE orders SET order_status = 'Out_for_Delivery' ...
activate DB
DB --> R: ok
deactivate DB
deactivate R

C --> V: 1.9 return {success: true, orderStatus: 'Out_for_Delivery'}
deactivate C
V --> S: 1.10 displayPickupConfirmedAndNavigationMap()
deactivate V

== Phase 2: Drop-Off Navigation & Arrival ==
S -> V: 2. updateGPSLocation(lat, lng)
activate V
V -> C: 2.1 navigateGPS(taskId, lat, lng)
activate C
C -> SH: 2.2 updateLocation(lat, lng)
C -> DT: 2.3 arriveAtDropoff()
C -> R: 2.4 saveTask(task)
activate R
R -> DB: 2.5 UPDATE delivery_tasks SET arrived_dropoff_at = ? ...
activate DB
DB --> R: ok
deactivate DB
deactivate R
C --> V: 2.6 return {success: true, arrived: true}
deactivate C
V --> S: 2.7 showCustomerContactAndDropoffUI()
deactivate V

== Phase 3: Successful Delivery & Cash COD Settlement ==
alt Normal Flow: Customer Receives and Pays Cash COD
    S -> V: 3a. confirmDeliveryAndCOD(taskId, 127500 VND)
    activate V
    V -> C: 3a.1 confirmDeliveryAndCOD(taskId, 127500)
    activate C
    
    C -> R: 3a.2 getOrderById(orderId)
    activate R
    R -> DB: 3a.3 SELECT * FROM orders WHERE order_id = ?
    activate DB
    DB --> R: order_row
    deactivate DB
    R --> C: order: Order
    deactivate R

    C -> DT: 3a.4 confirmSuccessfulDelivery(127500)
    activate DT
    DT --> C: taskStatus: 'Delivered'
    deactivate DT

    C -> R: 3a.5 saveTask(task)
    activate R
    R -> DB: 3a.6 UPDATE delivery_tasks SET task_status='Delivered', cod_collected_vnd=127500 ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R

    C -> R: 3a.7 updateOrderStatus(orderId, 'Delivered')
    activate R
    R -> DB: 3a.8 UPDATE orders SET order_status='Delivered', delivered_at=? ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R

    C -> R: 3a.9 updateShipperWallet(shipperId, +20000)
    activate R
    R -> DB: 3a.10 UPDATE shippers SET wallet_balance = wallet_balance + 20000 ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R

    C --> V: 3a.11 return {success: true, orderStatus: 'Delivered', credited: 20000}
    deactivate C
    V --> S: 3a.12 displayDeliverySuccessScreenAndWalletBonus()
    deactivate V

else Exception Flow: Customer Unreachable after 10-Minute Countdown
    S -> V: 3b. reportCustomerUnreachable()
    activate V
    V -> C: 3b.1 start10MinTimer(taskId)
    activate C
    C -> DT: 3b.2 start10MinCountdown()
    C -> R: 3b.3 saveTask(task)
    activate R
    R -> DB: 3b.4 UPDATE delivery_tasks SET task_status='Waiting_Customer_10Min' ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R
    C --> V: 3b.5 return {timerStarted: true, durationMins: 10}
    deactivate C
    V --> S: 3b.6 display10MinCountdownClock()
    deactivate V

    ... 10 minutes elapse without customer contact ...

    S -> V: 3c. confirmDeliveryFailure()
    activate V
    V -> C: 3c.1 recordDeliveryFailure(taskId, "Customer unreachable after 10m")
    activate C
    C -> DT: 3c.2 markDeliveryFailed(reason)
    C -> R: 3c.3 saveTask(task)
    activate R
    R -> DB: 3c.4 UPDATE delivery_tasks SET task_status='Failed_Returned', failure_reason=? ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R
    C -> R: 3c.5 updateOrderStatus(orderId, 'Delivery_Failed', reason)
    activate R
    R -> DB: 3c.6 UPDATE orders SET order_status='Delivery_Failed', cancellation_reason=? ...
    activate DB
    DB --> R: ok
    deactivate DB
    deactivate R
    C --> V: 3c.7 return {success: true, orderStatus: 'Delivery_Failed'}
    deactivate C
    V --> S: 3c.8 displayReturnPackageToHubScreen()
    deactivate V
end

@enduml
