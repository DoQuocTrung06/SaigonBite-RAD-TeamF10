@startuml
skinparam monochrome true
title UC7 & SaigonBite Order State Machine Diagram
[*] --> Placed : customerCheckout
Placed --> Confirmed : kitchenConfirm [time <= 2 mins]
Placed --> Rejected : kitchenReject [out of stock / station busy]
Placed --> Cancelled : slaTimeout [time > 2 mins]
Confirmed --> Preparing : stationTicketDistributed
Preparing --> Ready : allStationsComplete
Ready --> OutForDelivery : shipperScansQR
OutForDelivery --> Delivered : handoverSuccess
OutForDelivery --> FailedDelivery : customerUnreachable [after 10 mins]
Delivered --> [*]
Rejected --> [*]
Cancelled --> [*]
FailedDelivery --> [*]
@enduml
