@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam dpi 180
skinparam PackageStyle rectangle
skinparam nodesep 22
skinparam ranksep 65

left to right direction
right header 524H0136, 524H0031, 524H0132

actor "Customer" as Customer
actor "Office Staff" as Office
actor "Administrator" as Admin
actor "Kitchen Staff" as Kitchen
actor "Shipper" as Shipper
actor "Hub Manager" as Manager

rectangle "SaigonBite OFDH Platform" {

  package "(a) Ordering Subsystem" {
    usecase "UC2: Browse hubs, brands and menus" as UC2
    usecase "UC3: Place an order" as UC3
    usecase "UC6: Pay for an order" as UC6
    usecase "UC4: Track an order" as UC4
    usecase "UC5: Cancel or edit an order" as UC5
    usecase "UC11: Rate an order" as UC11
  }

  package "(c) CRUD & Office Management" {
    usecase "UC1: Register customer and manage addresses" as UC1
    usecase "UC12: Handle a complaint and decide on a refund" as UC12
    usecase "UC13: Manage hubs and kitchen capacity" as UC13
    usecase "UC14: Manage brands and menu items" as UC14
    usecase "UC15: Manage vouchers" as UC15
  }

  package "(b) Fulfilment & Logistics" {
    usecase "UC7: Confirm or reject an incoming order" as UC7
    usecase "UC8: Prepare an order and mark it ready" as UC8
    usecase "UC9: Manage menu item availability at a hub" as UC9
    usecase "UC10: Deliver an order" as UC10
  }

  package "(d) Management Reports" {
    usecase "UC16: Produce management reports" as UC16
  }
}

Customer -- UC2
Customer -- UC3
Customer -- UC6
Customer -- UC4
Customer -- UC5
Customer -- UC11
Customer -- UC1

Office -- UC12
Admin -- UC13
Admin -- UC14
Admin -- UC15

Kitchen -- UC7
Kitchen -- UC8
Kitchen -- UC9
Shipper -- UC10
Manager -- UC16

UC3 .right.> UC6 : <<include>>

@enduml
