@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classFontStyle bold
skinparam roundCorner 0
skinparam dpi 300
skinparam linetype ortho
hide circle

' --- CUSTOMER HIERARCHY ---
abstract class Customer {
    + customerId: String
    + fullName: String
    + createdAt: DateTime
}

class LocalCustomer {
    + phoneNumber: String
}

class ForeignTourist {
    + passportNumber: String
    + emailAddress: String
    + preferredLanguage: String
}

Customer <|-- LocalCustomer
Customer <|-- ForeignTourist

' --- HUB & KITCHEN STATIONS ---
class Hub {
    + hubId: String
    + hubName: String
    + address: String
    + latitude: Decimal
    + longitude: Decimal
    + maxCapacityOrders: Integer
    + isBusy: Boolean
}

class KitchenStation {
    + stationId: String
    + stationName: String
    + stationType: String
    + currentLoadOrders: Integer
    + capacityLimit: Integer
}

Hub *-- "1..*" KitchenStation : contains >

' --- BRAND & MENU ITEMS ---
class Brand {
    + brandId: String
    + brandName: String
    + cuisineType: String
    + status: String
}

class MenuItem {
    + itemId: String
    + itemName: String
    + description: String
    + unitPrice: Decimal
    + isAvailable: Boolean
    + stationType: String
}

Brand "1" -- "1..*" MenuItem : offers >

' --- ORDER & ORDER LINE ---
class Order {
    + orderId: String
    + orderTime: DateTime
    + orderStatus: String
    + deliveryAddress: String
    + distanceKm: Decimal
    + subtotal: Decimal
    + deliveryFee: Decimal
    + discountAmount: Decimal
    + finalTotal: Decimal
    + paymentMethod: String
}

class OrderLine {
    + quantity: Integer
    + itemPrice: Decimal
    + lineTotal: Decimal
    + specialNotes: String
}

class Voucher {
    + voucherCode: String
    + discountPercent: Decimal
    + maxDiscountAmount: Decimal
    + minOrderAmount: Decimal
    + startDate: DateTime
    + endDate: DateTime
    + usageQuota: Integer
    + status: String
}

class Payment {
    + paymentId: String
    + paymentMethod: String
    + paymentAmount: Decimal
    + paymentStatus: String
    + transactionRef: String
    + paymentTime: DateTime
}

' --- FULFILMENT & LOGISTICS ---
class KitchenTicket {
    + ticketId: String
    + stationId: String
    + status: String
    + printedTime: DateTime
    + completedTime: DateTime
}

class DeliveryTask {
    + taskId: String
    + shipperId: String
    + pickupTime: DateTime
    + deliveredTime: DateTime
    + deliveryStatus: String
    + cashCollected: Decimal
    + failureReason: String
}

' --- REPORTING ---
class ManagementReport {
    + reportId: String
    + hubId: String
    + reportType: String
    + generatedDate: DateTime
    + startDate: Date
    + endDate: Date
    + totalRevenue: Decimal
    + totalOrders: Integer
    + avgDeliveryMinutes: Decimal
    + wasteCost: Decimal
}

' --- ASSOCIATIONS ---
Customer "1" -down- "0..*" Order : places >
Order "0..*" -right- "0..1" Voucher : applies >
Order "1" -left- "1" Payment : paid via >

Order "1" -down- "1..*" OrderLine : contains >
OrderLine "*" -right- "1" MenuItem : references >

Order "1" -down- "1..*" KitchenTicket : routes to >
KitchenStation "1" -right- "0..*" KitchenTicket : prepares >

Order "1" -right- "1" DeliveryTask : fulfilled by >

Hub "1" -down- "0..*" Order : processes >
Hub "1" -right- "0..*" ManagementReport : generates >

@enduml
