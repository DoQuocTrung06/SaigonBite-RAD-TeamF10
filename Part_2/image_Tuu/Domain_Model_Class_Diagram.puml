@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classFontStyle bold
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam dpi 160
skinparam nodesep 70
skinparam ranksep 65
hide circle
hide empty methods

right header 524H0136, 524H0031, 524H0132

' --- CUSTOMER HIERARCHY ---
abstract class Customer {
    + customerId: String
    + fullName: String
    + createdAt: DateTime
}

class LocalCustomer {
    + phoneNumber: String
}

class ForeignTourist {
    + passportNumber: String
    + emailAddress: String
    + preferredLanguage: String
}

Customer <|-up- LocalCustomer
Customer <|-right- ForeignTourist

' --- HUB, STATIONS & REPORTING ---
class Hub {
    + hubId: String
    + hubName: String
    + address: String
    + latitude: Decimal
    + longitude: Decimal
    + maxCapacityOrders: Integer
    + isBusy: Boolean
}

class KitchenStation {
    + stationId: String
    + stationName: String
    + stationType: String
    + currentLoadOrders: Integer
    + capacityLimit: Integer
}

class ManagementReport {
    + reportId: String
    + hubId: String
    + reportType: String
    + generatedDate: DateTime
    + startDate: Date
    + endDate: Date
    + totalRevenue: Decimal
    + totalOrders: Integer
    + avgDeliveryMinutes: Decimal
    + wasteCost: Decimal
}

' --- BRAND & MENU ITEMS ---
class Brand {
    + brandId: String
    + brandName: String
    + cuisineType: String
    + status: String
}

class MenuItem {
    + itemId: String
    + itemName: String
    + description: String
    + unitPrice: Decimal
    + isAvailable: Boolean
    + stationType: String
}

' --- ORDER, VOUCHER & PAYMENT ---
class Order {
    + orderId: String
    + orderTime: DateTime
    + orderStatus: String
    + deliveryAddress: String
    + distanceKm: Decimal
    + subtotal: Decimal
    + deliveryFee: Decimal
    + discountAmount: Decimal
    + finalTotal: Decimal
    + paymentMethod: String
}

class OrderLine {
    + quantity: Integer
    + itemPrice: Decimal
    + lineTotal: Decimal
    + specialNotes: String
}

class Voucher {
    + voucherCode: String
    + discountPercent: Decimal
    + maxDiscountAmount: Decimal
    + minOrderAmount: Decimal
    + startDate: DateTime
    + endDate: DateTime
    + usageQuota: Integer
    + status: String
}

class Payment {
    + paymentId: String
    + paymentMethod: String
    + paymentAmount: Decimal
    + paymentStatus: String
    + transactionRef: String
    + paymentTime: DateTime
}

' --- FULFILMENT & LOGISTICS ---
class KitchenTicket {
    + ticketId: String
    + stationId: String
    + status: String
    + printedTime: DateTime
    + completedTime: DateTime
}

class DeliveryTask {
    + taskId: String
    + shipperId: String
    + pickupTime: DateTime
    + deliveredTime: DateTime
    + deliveryStatus: String
    + cashCollected: Decimal
    + failureReason: String
}

' --- ASSOCIATIONS ---
Voucher "0..1" -down- "0..*" Order : < applies
Payment "1" -down- "1" Order : < paid via
Hub "1" -up- "0..*" ManagementReport : generates >
Hub "1" -down- "0..*" Order : processes >
Hub "1" *-- "1..*" KitchenStation : contains >

Order "0..*" -right- "1" Customer : < places
Order "1" -left- "1" DeliveryTask : fulfilled by >

Order "1" -down- "1..*" OrderLine : contains >
Order "1" -down- "1..*" KitchenTicket : routes to >
OrderLine -[hidden]right-> KitchenTicket

KitchenTicket "0..*" -right- "1" KitchenStation : < prepares
OrderLine "*" -down- "1" MenuItem : references >
MenuItem "1..*" -left- "1" Brand : < offers

@enduml
