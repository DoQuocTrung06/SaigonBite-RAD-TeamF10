@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam dpi 300
skinparam linetype ortho

[*] --> ReadyForPickup : kitchenReady
ReadyForPickup --> Assigned : assignShipper
Assigned --> OutForDelivery : scanHubPickupQR
OutForDelivery --> ArrivedAtCustomer : arriveAtAddress

state DeliveryChoice <<choice>>

ArrivedAtCustomer --> DeliveryChoice

DeliveryChoice --> Delivered : [Handover & COD Paid]\nconfirmHandover
DeliveryChoice --> FailedDelivery : [Unreachable > 10m]\ntimeoutCountdown

FailedDelivery --> ReturningToHub : initiateReturnTrip

state " " as endSuccess <<end>>
state " " as endReturned <<end>>

Delivered --> endSuccess
ReturningToHub --> endReturned : packageReturned

@enduml
