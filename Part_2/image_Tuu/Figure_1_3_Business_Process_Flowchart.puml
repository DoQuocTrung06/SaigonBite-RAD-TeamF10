@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 6
skinparam dpi 170

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.3
skinparam ActivityFontColor #000000

skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBorderThickness 1.3
skinparam ActivityDiamondFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 10

skinparam partition {
  BorderColor #000000
  BorderThickness 1.2
  FontColor #000000
  FontSize 12
  FontStyle bold
  BackgroundColor #FFFFFF
}

right header 524H0031, 524H0132

start

partition "1. Catalog & Campaign Readiness" {
  :Configure Cloud Kitchen Hubs, Station Capacities & Virtual Brands (UC13, UC14);
  :Publish Bilingual Menus (VI/EN) & Promotional Vouchers (UC14, UC15);
}

partition "2. Multi-Brand Ordering & Checkout" {
  :Authenticate Local Customer or Foreign Tourist & Select Hub (UC1, UC2);
  :Build Multi-Brand Basket & Enter Delivery Address (UC2, UC3);
  :Validate Single-Hub Rule (< 85% Load) & Delivery Radius (<= 7.0 km) (UC3);
  if (Hub & Radius Eligible?) then ([Yes])
    :Calculate Distance Fee, 10% Quiet-Kitchen (< 40% Load) & Voucher Discount (UC3);
    :Select Payment (Online Authorization or COD in VND) & Place Order (UC3, UC6);
  else ([No])
    :Alert Customer to Adjust Basket or Address;
    stop
  endif
}

partition "3. Cloud Kitchen Fulfilment" {
  :Route Order to Hub Kitchen Display System (120-Second Confirmation SLA) (UC7);
  if (Ingredients & Stations Available?) then ([Confirmed])
    :Lock Delivery Address & Dispatch Tickets to Stations (Wok, Fryer, Assembly, Beverage) (UC7, UC8);
    :Prepare Dishes Across Stations, Consolidate Package & Mark Order Ready (UC8);
  else ([Rejected / Timeout])
    :Reject Order, Update Hub Item Availability & Trigger Refund (UC7, UC9);
    stop
  endif
}

partition "4. Last-Mile Delivery & Post-Order Analytics" {
  :Shipper Scans QR Code at Hub Counter & Navigates to Address/Hotel (UC10);
  if (Customer Reached Within 10 Minutes?) then ([Delivered])
    :Hand Over Order, Collect VND Cash (if COD) & Issue Digital Receipt (UC10);
    :Customer Rates Order / Submits Complaint & Manager Reviews KPI Reports (UC11, UC12, UC16);
  else ([Unreachable])
    :Record Failed Delivery & Return Package to Hub (UC10);
  endif
}

stop
@enduml
