@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam dpi 300

actor "Hub Manager" as Manager
participant ":SaigonBiteSystem" as System

Manager -> System: openReportingConsole()
System --> Manager: displayFilterCriteria(hubList, datePresets, metricOptions)

Manager -> System: requestManagementReport(hubId, startDate, endDate, metricTypes)
System --> Manager: displayReportDashboard(reportId, revenueKPI, stationLoadKPI, courierSLAKPI)

alt Manager Exports Report Document
  Manager -> System: exportReport(reportId, format="PDF")
  System --> Manager: returnDocumentDownloadLink(pdfFileUrl)
end

@enduml