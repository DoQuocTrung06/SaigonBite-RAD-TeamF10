@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 145
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceBoxBorderColor #000000
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000
skinparam ParticipantFontSize 9

skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 9

right header 524H0031

actor "Administrator" as Admin
participant "<<view>>\n__:BrandCatalog__\n__Window__" as View
participant "<<controller>>\n__:BrandCatalog__\n__Handler__" as Ctrl
participant "__aB:Brand__" as Brand
participant "<<dataAccess>>\n__:BrandDA__" as BrandDA
participant "__aH:Hub__" as Hub
participant "<<dataAccess>>\n__:HubDA__" as HubDA
participant "__aKS:Kitchen__\n__Station__" as Station
participant "__aMI:MenuItem__" as MenuItem
participant "<<dataAccess>>\n__:MenuItemDA__" as MenuItemDA

Admin -> View: openBrandCatalog()
activate View
View -> Ctrl: openBrandCatalog()
activate Ctrl
Ctrl -> Brand: getAllBrands()
activate Brand
Brand -> BrandDA: readAllBrands()
activate BrandDA
BrandDA --> Brand: brandList
deactivate BrandDA
Brand --> Ctrl: brandList
deactivate Brand
Ctrl -> Hub: getActiveHubs()
activate Hub
Hub -> HubDA: readActiveHubs()
activate HubDA
HubDA --> Hub: hubList
deactivate HubDA
Hub --> Ctrl: hubList
deactivate Hub
Ctrl --> View: brand list, hub assignments
deactivate Ctrl
View --> Admin: brand list, hub assignments
deactivate View

Admin -> View: selectBrand(brandId)
activate View
View -> Ctrl: selectBrand(brandId)
activate Ctrl
Ctrl -> Brand: getBrandCatalog(brandId)
activate Brand
Brand -> BrandDA: readBrand(brandId)
activate BrandDA
BrandDA --> Brand: aB
deactivate BrandDA
Brand -> MenuItem: getBrandMenuItems(brandId)
activate MenuItem
MenuItem -> MenuItemDA: readMenuItemsByBrand(brandId)
activate MenuItemDA
MenuItemDA --> MenuItem: itemList
deactivate MenuItemDA
MenuItem --> Brand: itemList
deactivate MenuItem
Brand --> Ctrl: brandDetails, itemList
deactivate Brand
Ctrl -> Hub: getAvailableStations(brandId)
activate Hub
Hub -> HubDA: readHubsByBrand(brandId)
activate HubDA
HubDA --> Hub: assignedHubs
deactivate HubDA
Hub --> Ctrl: availableStations
deactivate Hub
Ctrl --> View: brand details, menu items, available stations
deactivate Ctrl
View --> Admin: brand details, menu items, available stations
deactivate View

Admin -> View: saveBrandDetails(brandName, cuisineType, assignedHubs)
activate View
View -> Ctrl: saveBrandDetails(brandName, cuisineType, assignedHubs)
activate Ctrl
Ctrl -> Brand: saveBrandProfile(brandName, cuisineType, assignedHubs)
activate Brand
Brand -> BrandDA: [valid brand details] saveBrand(aB, assignedHubs)
activate BrandDA
BrandDA --> Brand: brandId
deactivate BrandDA
Brand --> Ctrl: brand confirmation
deactivate Brand
Ctrl --> View: brand confirmation
deactivate Ctrl
View --> Admin: brand confirmation
deactivate View

Admin -> View: saveMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType)
activate View
View -> Ctrl: saveMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType)
activate Ctrl
Ctrl -> Hub: verifyStationSupport(stationType)
activate Hub
Hub -> Station: checkStationType(stationType)
activate Station
Station --> Hub: stationSupported
deactivate Station
Hub --> Ctrl: stationSupported
deactivate Hub
Ctrl -> Brand: saveBrandMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType)
activate Brand
Brand -> MenuItem: publishMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType)
activate MenuItem
MenuItem -> MenuItemDA: [valid item details] saveMenuItem(brandId, aMI)
activate MenuItemDA
MenuItemDA --> MenuItem: itemSaved
deactivate MenuItemDA
MenuItem --> Brand: aMI
deactivate MenuItem
Brand --> Ctrl: updated menu catalog, state Active
deactivate Brand
Ctrl --> View: updated menu catalog, state Active
deactivate Ctrl
View --> Admin: updated menu catalog, state Active
deactivate View

Admin -> View: [discontinue item] discontinueMenuItem(itemCode)
activate View
View -> Ctrl: discontinueMenuItem(itemCode)
activate Ctrl
Ctrl -> Brand: discontinueBrandItem(itemCode)
activate Brand
Brand -> MenuItem: discontinueItem(itemCode)
activate MenuItem
MenuItem -> MenuItemDA: updateMenuItemStatus(itemCode, "Discontinued")
activate MenuItemDA
MenuItemDA --> MenuItem: statusUpdated
deactivate MenuItemDA
MenuItem --> Brand: statusUpdated
deactivate MenuItem
Brand --> Ctrl: confirmation, state Discontinued
deactivate Brand
Ctrl --> View: confirmation, state Discontinued
deactivate Ctrl
View --> Admin: confirmation, state Discontinued
deactivate View

@enduml
