@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontStyle bold
skinparam roundcorner 14
skinparam dpi 200
skinparam linetype ortho
hide empty description

skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #000000
skinparam StateBorderThickness 1.5
skinparam StateFontColor #000000
skinparam StateFontStyle bold

skinparam ArrowColor #000000
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11
skinparam ArrowFontStyle normal

skinparam nodesep 70
skinparam ranksep 60

right header 524H0031

state "Active" as Active
state "Suspended" as Suspended
state "Discontinued" as Discontinued

' Top Row - Product Lifecycle Happy Path
[*] -right-> Active : createMenuItem [valid price and station]
Active -right-> Discontinued : discontinueItem
Discontinued -right-> [*] : archive

' Bottom Row - Operational Exception
Active -down-> Suspended : suspendItem [out of stock]
Suspended -up-> Active : restockItem
Suspended -right-> Discontinued : discontinueItem

@enduml
