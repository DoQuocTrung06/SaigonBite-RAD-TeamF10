@startuml
skinparam monochrome true
title UC14: Manage Brands and Menu Items - System Sequence Diagram (SSD)
actor "Administrator" as Admin
participant ":SaigonBiteSystem" as System

Admin -> System: registerVirtualBrand(brandDetails, hubAssignments)
System --> Admin: brandRegistered(brandId)

Admin -> System: addMenuItem(brandId, itemDetails, stationCode, price)
System --> Admin: menuItemSaved(itemId, catalogStatus)

Admin -> System: toggleItemAvailability(hubId, itemId, inStockStatus)
System --> Admin: availabilitySynchronized(hubId, itemId)
@enduml
