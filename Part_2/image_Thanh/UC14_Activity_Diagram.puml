@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 5
skinparam shadowing false
skinparam dpi 160

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.3
skinparam ActivityFontColor #000000
skinparam ActivityPadding 11
skinparam ActivityMargin 6

skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBorderThickness 1.3
skinparam ActivityDiamondFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11

skinparam partition {
  BorderColor #000000
  BorderThickness 1.3
  FontColor #000000
  FontSize 13
  FontStyle bold
  BackgroundColor #FFFFFF
}

skinparam RankSep 44
skinparam NodeSep 55

right header 524H0031

|Administrator|
|SaigonBite System|

|Administrator|
start
:Open brand and menu catalog;

|SaigonBite System|
:Display brands and hub assignments;

|Administrator|
:Select virtual brand;

|SaigonBite System|
:Display brand details and menu items;

|Administrator|
:Enter brand details and assigned hubs;

|SaigonBite System|
:Validate brand details and hub assignments;
if (Brand details valid?) then ([Yes])
  :Confirm brand and prompt for menu items;
else ([No])
  :Display brand validation error;
  stop
endif

|Administrator|
:Enter menu item details or select discontinue;

|SaigonBite System|
:Validate item code, price, and station;
if (Item details valid?) then ([Yes])
  :Save menu item (state Active or Discontinued);
else ([No])
  :Display item validation error;
  stop
endif

:Publish updated menu to assigned hubs;
:Display update confirmation;

|Administrator|
:Receive update confirmation;
stop

@enduml
