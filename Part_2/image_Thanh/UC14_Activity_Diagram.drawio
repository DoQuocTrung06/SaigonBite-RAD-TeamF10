          <mxGeometry height="100" width="280" x="85" y="410" as="geometry" />
        </mxCell>
        <mxCell id="act_correct" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;align=center;arcSize=20;fontSize=11;" value="Review &amp; correct invalid input fields&#xa;(or click Cancel to revert)" vertex="1">
          <mxGeometry height="45" width="280" x="85" y="550" as="geometry" />
        </mxCell>
