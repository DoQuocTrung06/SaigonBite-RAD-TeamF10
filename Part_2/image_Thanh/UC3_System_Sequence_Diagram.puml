@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam dpi 300

actor "Customer" as Customer
participant ":SaigonBiteSystem" as System

Customer -> System: addDishesToCart(hubId, brandId, itemId, quantity, notes)
System --> Customer: returnCartSummary(items, subtotal)

Customer -> System: enterDeliveryAddress(dropOffAddress)
System --> Customer: returnDistanceAndDeliveryFee(distanceKm, deliveryFee)

opt Customer Applies Voucher
  Customer -> System: applyVoucher(voucherCode)
  System --> Customer: returnDiscountedBreakdown(discountAmount, finalTotal)
end

Customer -> System: submitOrderCheckout(paymentMethod, finalAmount)
alt Online Payment
  System -> Customer: promptPaymentGatewaySandbox(transAmount)
  Customer -> System: authorizePaymentCallback(token)
  System --> Customer: confirmOrderPlaced(orderId, orderStatus="Placed", prepETA)
else Cash on Delivery (COD)
  System --> Customer: confirmOrderPlaced(orderId, orderStatus="Placed", prepETA)
end

@enduml