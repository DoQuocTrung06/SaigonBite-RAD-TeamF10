<mxfile host="Electron" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="UC14_State_Machine" name="UC14 State Machine Diagram">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="750" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== STATE NODES ==================== -->
        <!-- Initial Pseudo-State (●) -->
        <mxCell id="s_init" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="485" y="20" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Available State -->
        <mxCell id="s_available" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Available&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #444444;&quot;&gt;entry / broadcastCatalogUpdate()&lt;br&gt;do / acceptCustomerOrders()&lt;br&gt;exit / syncMenuAvailability()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="300" height="75" as="geometry" />
        </mxCell>

        <!-- 2. Suspended State -->
        <mxCell id="s_suspended" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Suspended&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #444444;&quot;&gt;entry / throttleStationOrders() (FR3)&lt;br&gt;do / displayHighLoadNotice()&lt;br&gt;exit / resumeStationCapacity()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- 3. OutOfStock State -->
        <mxCell id="s_outofstock" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;OutOfStock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #444444;&quot;&gt;entry / lockItemInActiveCarts()&lt;br&gt;do / displayOutOfStockNotice()&lt;br&gt;entry / recordAuditLog(auditLogId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="310" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- 4. Archived State -->
        <mxCell id="s_archived" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Archived&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #444444;&quot;&gt;entry / removeFromAllHubMenus()&lt;br&gt;entry / lockItemModifications()&lt;br&gt;entry / recordAuditLog(auditLogId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="520" width="300" height="75" as="geometry" />
        </mxCell>

        <!-- Final Pseudo-State (◉) -->
        <mxCell id="s_final" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="485" y="660" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== TRANSITIONS (ZERO COLLISION, 100% PLANAR) ==================== -->
        <!-- ● -> Available -->
        <mxCell id="t_init_avail" value="submitMenuItem [status == &quot;Active&quot; &amp;amp;&amp;amp; unitPrice &gt; 0] / setAvailable(true)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_init" target="s_available">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Self-loop on Available (Update details) -->
        <mxCell id="t_avail_loop" value="submitMenuItem [unitPrice &gt; 0] / updateDetails()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=right;verticalAlign=middle;fontSize=10;spacingRight=5;" edge="1" parent="1" source="s_available" target="s_available">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="120" />
              <mxPoint x="270" y="120" />
              <mxPoint x="270" y="155" />
              <mxPoint x="350" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Available -> Suspended (Kitchen station load >= 85%) -->
        <mxCell id="t_avail_susp" value="stationOverloaded [load &gt;= 85%] / throttleOrders()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="175" as="sourcePoint" />
            <mxPoint x="150" y="310" as="targetPoint" />
            <Array as="points">
              <mxPoint x="380" y="220" />
              <mxPoint x="150" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Suspended -> Available (Kitchen station load normalized < 85%) -->
        <mxCell id="t_susp_avail" value="stationLoadNormalized [load &lt; 85%] / resumeOrders()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=top;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="310" as="sourcePoint" />
            <mxPoint x="430" y="175" as="targetPoint" />
            <Array as="points">
              <mxPoint x="250" y="265" />
              <mxPoint x="430" y="265" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Available -> OutOfStock (Admin or Kitchen sets stock false) -->
        <mxCell id="t_avail_oos" value="toggleItemStock [isAvailable == false] / lockItemInCarts()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="175" as="sourcePoint" />
            <mxPoint x="850" y="310" as="targetPoint" />
            <Array as="points">
              <mxPoint x="620" y="220" />
              <mxPoint x="850" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- OutOfStock -> Available (Restocked, stock true) -->
        <mxCell id="t_oos_avail" value="toggleItemStock [isAvailable == true] / unlockItemInCarts()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=top;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="310" as="sourcePoint" />
            <mxPoint x="570" y="175" as="targetPoint" />
            <Array as="points">
              <mxPoint x="750" y="265" />
              <mxPoint x="570" y="265" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Available -> Archived (Central vertical corridor x=500) -->
        <mxCell id="t_avail_arch" value="submitMenuItem [status == &quot;Archived&quot;] / recordAuditLog()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="175" as="sourcePoint" />
            <mxPoint x="500" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Suspended -> Archived (Cascade brand archived) -->
        <mxCell id="t_susp_arch" value="cascadeBrandArchived / hideFromAllHubMenus()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="385" as="sourcePoint" />
            <mxPoint x="390" y="520" as="targetPoint" />
            <Array as="points">
              <mxPoint x="200" y="455" />
              <mxPoint x="390" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- OutOfStock -> Archived (Admin archives out of stock item) -->
        <mxCell id="t_oos_arch" value="submitMenuItem [status == &quot;Archived&quot;] / recordAuditLog()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="385" as="sourcePoint" />
            <mxPoint x="610" y="520" as="targetPoint" />
            <Array as="points">
              <mxPoint x="800" y="455" />
              <mxPoint x="610" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Archived -> Final (◉) -->
        <mxCell id="t_arch_fin" value="purgeRecord / deleteFromDatabase()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_archived" target="s_final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>