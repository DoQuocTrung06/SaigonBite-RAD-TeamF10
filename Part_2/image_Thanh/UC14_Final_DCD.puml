@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 46
skinparam ranksep 46

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 10
skinparam ClassStereotypeFontColor #000000
skinparam ClassStereotypeFontSize 9

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000

hide circle
show members
top to bottom direction
right header 524H0031

class BrandCatalogWindow <<view>> {
  --
  +openBrandCatalog(): string
  +selectBrand(brandId): string
  +saveBrandDetails(brandName, cuisineType, assignedHubs): string
  +saveMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType): string
  +discontinueMenuItem(itemCode): string
}

class BrandCatalogHandler <<controller>> {
  --
  +openBrandCatalog(): List
  +selectBrand(brandId): Brand
  +saveBrandDetails(brandName, cuisineType, assignedHubs): string
  +saveMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType): string
  +discontinueMenuItem(itemCode): string
}

class BrandDA <<dataAccess>> {
  --
  +readAllBrands(): List
  +readBrand(brandId): Brand
  +saveBrand(brand, assignedHubs): string
}

class Brand {
  -brandId: string {key}
  -brandName: string
  -cuisineType: string
  -status: string
  --
  +getAllBrands(): List
  +getBrandCatalog(brandId): Brand
  +saveBrandProfile(brandName, cuisineType, assignedHubs): string
  +saveBrandMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType): string
  +discontinueBrandItem(itemCode): string
}

class Hub {
  -hubId: string {key}
  -hubName: string
  -address: string
  -maxCapacityOrders: int
  -hubStatus: string
  --
  +getActiveHubs(): List
  +getAvailableStations(brandId): List
  +verifyStationSupport(stationType): boolean
}

class HubDA <<dataAccess>> {
  --
  +readActiveHubs(): List
  +readHubsByBrand(brandId): List
}

class MenuItemDA <<dataAccess>> {
  --
  +readMenuItemsByBrand(brandId): List
  +saveMenuItem(brandId, item): boolean
  +updateMenuItemStatus(itemCode, status): boolean
}

class MenuItem {
  -itemId: string {key}
  -itemNameVi: string
  -itemNameEn: string
  -description: string
  -unitPrice: currency
  -stationType: string
  -status: string
  --
  +getBrandMenuItems(brandId): List
  +publishMenuItem(itemCode, nameVi, nameEn, unitPrice, stationType): MenuItem
  +discontinueItem(itemCode): boolean
}

class KitchenStation {
  -stationId: string {key}
  -stationName: string
  -stationType: string
  -currentLoad: int
  -capacityLimit: int
  --
  +checkStationType(stationType): boolean
}

' Row 0 -> Row 1
BrandCatalogWindow -down-> BrandCatalogHandler

' Row 1 -> Row 2
BrandCatalogHandler -down-> Brand
BrandCatalogHandler -down-> Hub

' Row 2: BrandDA <-- Brand --> Hub --> HubDA
Brand -left-> BrandDA
Brand -right-> Hub
Hub -right-> HubDA

' Row 2 -> Row 3
BrandDA -[hidden]down-> MenuItemDA
Brand -down-> MenuItem
Hub -down-> KitchenStation

' Row 3: MenuItemDA <-- MenuItem   KitchenStation
MenuItem -left-> MenuItemDA
MenuItem -[hidden]right-> KitchenStation

@enduml
