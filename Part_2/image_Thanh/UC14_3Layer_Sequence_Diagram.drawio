        <!-- MenuItem self-call: setAvailable(true) (Khớp 1-1 với State Machine Diagram!) -->
        <mxCell id="m_ent_avail" value="setAvailable(true)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1">
