<mxfile host="Electron" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="UC15_State_Machine" name="UC15 State Machine Diagram">
    <mxGraphModel dx="1200" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1150" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== STATE NODES (CĂN GIỮA TRỤC X=330) ==================== -->
        <!-- Initial Pseudo-State (●) -->
        <mxCell id="s_init" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="415" y="40" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Scheduled State -->
        <mxCell id="s_scheduled" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Scheduled&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555555;&quot;&gt;entry / queueActivationTimer()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- 2. Active State -->
        <mxCell id="s_active" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Active&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555555;&quot;&gt;entry / enableCheckoutValidation()&lt;br&gt;do / monitorUsageAndExpiry()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- 3. Depleted State -->
        <mxCell id="s_depleted" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Depleted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555555;&quot;&gt;entry / lockVoucher()&lt;br&gt;do / notifyMarketingQuotaExhausted()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- 4. Expired State -->
        <mxCell id="s_expired" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Expired&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555555;&quot;&gt;entry / expire()&lt;br&gt;entry / scheduleAutoArchive(30d)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="670" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- 5. Archived State -->
        <mxCell id="s_archived" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Archived&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555555;&quot;&gt;entry / moveToArchiveStorage()&lt;br&gt;entry / logAuditRecord()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Final State (◉) -->
        <mxCell id="s_final" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="415" y="1000" width="30" height="30" as="geometry" />
        </mxCell>


        <!-- ==================== CÁC ĐƯỜNG CHUYỂN DỌC TRUNG TÂM ==================== -->
        <!-- ● -> Scheduled -->
        <mxCell id="t_init_sched" value="createVoucher [currentTime &lt; startDate] / setStatus(&quot;Scheduled&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_init" target="s_scheduled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Scheduled -> Active -->
        <mxCell id="t_sched_act" value="timerTrigger [currentTime &gt;= startDate] / activate()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_scheduled" target="s_active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Active -> Depleted (Hết lượt) - Đi trục giữa bên trái X=390 -->
        <mxCell id="t_act_dep" value="applyVoucher [timesUsed + 1 == usageQuota] / lockVoucher()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=right;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_active" target="s_depleted">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="380" />
              <mxPoint x="380" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Depleted -> Active (Nạp thêm quota) - Đi trục giữa bên phải X=480 -->
        <mxCell id="t_dep_act" value="updateVoucher [newQuota &gt; timesUsed] / unlockVoucher()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_depleted" target="s_active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="420" />
              <mxPoint x="480" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Depleted -> Expired (Hết hạn ngày khi đã hết quota) -->
        <mxCell id="t_dep_exp" value="timerExpiry [currentTime &gt; endDate] / expire()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_depleted" target="s_expired">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Expired -> Archived (Tự động lưu trữ sau 30 ngày) -->
        <mxCell id="t_exp_arch" value="autoArchive [after 30 days] / archiveRecord()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_expired" target="s_archived">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Archived -> ◉ Final -->
        <mxCell id="t_arch_fin" value="purgeVoucher / removeData()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="s_archived" target="s_final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ==================== CÁC ĐƯỜNG VÒNG HÀNH LANG PHẢI (EAST CORRIDOR) ==================== -->
        <!-- ● -> Active (Tạo voucher hiệu lực ngay) - Vòng hành lang phải X=620 -->
        <mxCell id="t_init_act" value="createVoucher [currentTime &gt;= startDate] / activate()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_init" target="s_active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="55" />
              <mxPoint x="640" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Active Self-loop (Khách áp mã thành công) - Bọc bên phải X=600 -->
        <mxCell id="t_act_loop" value="applyVoucher [timesUsed + 1 &lt; usageQuota] / timesUsed++" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_active" target="s_active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="300" />
              <mxPoint x="600" y="300" />
              <mxPoint x="600" y="325" />
              <mxPoint x="540" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Active -> Expired (Đang active mà hết hạn) - Vòng hành lang phải X=720 -->
        <mxCell id="t_act_exp" value="timerExpiry [currentTime &gt; endDate] / expire()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_active" target="s_expired">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="310" />
              <mxPoint x="740" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>


        <!-- ==================== CÁC ĐƯỜNG VÒNG HÀNH LANG TRÁI (WEST CORRIDOR: DEACTIVATE) ==================== -->
        <!-- Scheduled -> Archived - Vòng hành lang trái X=100 -->
        <mxCell id="t_sched_arch" value="deactivateVoucher / logAudit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=right;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_scheduled" target="s_archived">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="167" />
              <mxPoint x="100" y="885" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Active -> Archived - Vòng hành lang trái X=180 -->
        <mxCell id="t_act_arch" value="deactivateVoucher / logAudit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=right;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_active" target="s_archived">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="295" />
              <mxPoint x="180" y="905" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Depleted -> Archived - Vòng hành lang trái X=250 -->
        <mxCell id="t_dep_arch" value="deactivateVoucher / logAudit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;align=right;verticalAlign=middle;fontSize=10;" edge="1" parent="1" source="s_depleted" target="s_archived">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="502" />
              <mxPoint x="250" y="925" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
