@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 10
skinparam ClassStereotypeFontColor #000000
skinparam ClassStereotypeFontSize 9

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000

hide circle
show members
top to bottom direction
right header 524H0132

' Layer 1: View
class KDSConsoleUI <<view>> {
  --
  +tapConfirm(orderId: string): void
  +showConfirmationDialog(orderId: string): void
  +tapConfirmYes(orderId: string): void
  +displayConfirmation(orderId: string, status: string, eta: int): void
  +displayRejectionAlert(orderId: string, reason: string): void
}

' Layer 2: Controller
class KitchenController <<controller>> {
  --
  +confirmOrder(orderId: string): OrderConfirmationDTO
  +rejectOrder(orderId: string, reason: string): boolean
  -stop120sTimer(orderId: string): void
  -calculateETA(order: Order, activeLoadPercent: int): int
}

' Layer 3: Data Access
class OrderDAO <<dataAccess>> {
  --
  +getOrder(orderId: string): Order
  +updateOrder(order: Order): boolean
  +getActiveKitchenLoad(hubId: string): int
  +setHubStatus(hubId: string, status: string): boolean
}

class KitchenTicketDAO <<dataAccess>> {
  --
  +insertTicket(ticket: KitchenTicket): string
}

class AuditLogDAO <<dataAccess>> {
  --
  +recordAuditLog(action: string, staffId: string, orderId: string, timestamp: datetime): string
}

' Layer 4: Domain
class Order {
  -orderId: string {key}
  -orderTime: datetime
  -orderStatus: string
  -deliveryAddress: string
  -distanceKm: decimal
  -subtotal: decimal
  -deliveryFee: decimal
  -discountAmount: decimal
  -finalTotal: decimal
  -paymentMethod: string
  -rejectionReason: string
  --
  +confirmAndLockDetails(): void
  +splitItemsByStation(): Map
}

class KitchenTicket {
  -ticketId: string {key}
  -stationId: string
  -status: string
  -printedTime: datetime
  -completedTime: datetime
  --
  +create(orderId: string, stationId: string, items: List): KitchenTicket
  +dispatchAndPrintTicket(): void
}

' Hierarchy & Layout
KDSConsoleUI -down-> KitchenController

KitchenController -left-> OrderDAO
KitchenController -right-> AuditLogDAO
KitchenController -down-> Order

Order "1" --> "1..*" KitchenTicket

KitchenController -down-> KitchenTicketDAO

@enduml