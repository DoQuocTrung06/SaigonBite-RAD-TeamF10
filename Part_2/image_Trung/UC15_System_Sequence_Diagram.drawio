        <!-- createVoucher(...) -->
        <mxCell id="msg3" value="createVoucher(voucherCode, campaignType, discountValue, minOrderAmount, usageQuota, startDate, endDate)" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.2;endFill=1;align=center;verticalAlign=bottom;fontSize=10;" edge="1" parent="1">
