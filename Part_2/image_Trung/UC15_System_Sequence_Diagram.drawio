<mxfile host="Electron" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="UC15_SSD" name="UC15 System Sequence Diagram">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== ACTOR LIFELINE ==================== -->
        <!-- Actor Symbol -->
        <mxCell id="actor_icon" value=":Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Actor Lifeline (dashed) -->
        <mxCell id="actor_line" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="165" y="125" as="sourcePoint" />
            <mxPoint x="165" y="1120" as="targetPoint" />
          </mxGeometry>
        </mxCell>


        <!-- ==================== SYSTEM LIFELINE ==================== -->
        <!-- System Box -->
        <mxCell id="system_box" value=":System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- System Lifeline (dashed) -->
        <mxCell id="system_line" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="690" y="100" as="sourcePoint" />
            <mxPoint x="690" y="1120" as="targetPoint" />
          </mxGeometry>
        </mxCell>


        <!-- ==================== INITIAL INTERACTION ==================== -->
        <!-- openVoucherConsole() -->
        <mxCell id="msg1" value="openVoucherConsole()" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.2;endFill=1;align=center;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="165" y="150" as="sourcePoint" />
            <mxPoint x="690" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- voucherCampaignList (return) -->
        <mxCell id="msg2" value="voucherCampaignList" style="endArrow=open;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.2;endFill=0;align=center;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
