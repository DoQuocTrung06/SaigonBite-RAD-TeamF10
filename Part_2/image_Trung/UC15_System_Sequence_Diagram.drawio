        <!-- Outer Alt Frame -->
        <mxCell id="alt_main" value="" style="shape=rect;fillColor=none;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="730" height="840" as="geometry" />
        </mxCell>

        <!-- Alt Label Box -->
        <mxCell id="alt_tag" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;width=45;height=22;fontStyle=1;fontSize=11;" vertex="1" parent="1">
