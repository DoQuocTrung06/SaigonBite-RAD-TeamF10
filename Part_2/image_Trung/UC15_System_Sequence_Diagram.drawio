        </mxCell>
        <mxCell id="alt_sub2_tag" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;width=35;height=18;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="600" width="670" height="155" as="geometry" />
        </mxCell>
        <mxCell id="guard2_valid" value="[Valid newQuota &gt;= timesUsed]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="155" y="600" width="180" height="20" as="geometry" />
        </mxCell>

        <!-- confirmVoucherUpdated return -->
        <mxCell id="msg7" value="confirmVoucherUpdated(voucherId)" style="endArrow=open;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.2;endFill=0;align=center;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
