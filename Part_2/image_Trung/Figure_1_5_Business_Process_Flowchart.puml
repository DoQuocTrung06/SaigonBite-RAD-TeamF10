@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ActivityBorderThickness 1.2
skinparam ArrowThickness 1.0

start

:Browse virtual brand profiles and hub menus;

:Select dishes from multiple virtual brands into unified cart;

if (Apply promotional voucher?) then ([yes: Valid voucher])
  :Validate validity period, minimum spend, and quota;
  :Apply promotional discount to order subtotal;
else ([no voucher])
endif

:Calculate distance-based delivery fee (radius <= 7.0 km);

:Select payment method (COD in VND or Online Card) and submit order;

:Route order to designated kitchen hub and check station workloads;

if (Active kitchen station load < 85% capacity?) then ([yes: Normal load])
  :Dispatch digital preparation tickets to specialized KDS cooking stations;
else ([no: Overloaded >= 85%])
  :System flags kitchen hub as 'Busy' and throttles order intake;
  :Offer 10% quiet-hub discount alternative or cancel order;
  stop
endif

if (Kitchen staff confirms order within 120 seconds?) then ([yes: Confirmed])
  :Lock order line items and customer delivery address permanently;
else ([no: Rejected / Timeout])
  :Kitchen staff records rejection reason (or system triggers 120s timeout);
  :Cancel order and initiate automatic online payment refund;
  :Notify customer of order cancellation;
  stop
endif

:Cook dishes concurrently at specialized stations (Wok, Grill, Fryer);
:Consolidate dishes at Assembly station into tamper-evident package;
:Mark order status as 'ReadyForPickup';

:Assign delivery courier to order and notify shipper;
:Shipper arrives at hub, verifies order code, and collects package;
:Shipper transits via GPS to customer delivery address (<= 7.0 km);

if (Customer reachable at doorstep within 10 minutes?) then ([yes: Handover])
  :Collect COD cash in VND (or verify digital payment status);
else ([no: Unreachable > 10 mins])
  :Record delivery failure and mark order status as 'Failed';
  :Shipper receives full delivery fee and returns package to hub;
  stop
endif

:Customer inspects tamper-evident seal and receives package;
:Shipper marks order status as 'Delivered';
:Record immutable audit log entry within 1 second;
:Consolidate operational records for sales, workload, and courier transit;
:Generate periodic management and kitchen workload reports;

if (Customer files complaint within policy window?) then ([yes: Complaint filed])
  :Office staff reviews customer complaint and order audit trail;
  if (Refund approved by office staff?) then ([yes: Approved])
    :Process electronic refund to customer account;
    stop
  else ([no: Rejected])
    :Issue formal rejection explanation to customer;
    stop
  endif
else ([no complaint])
  :Customer submits optional rating for food quality and delivery service;
  stop
endif

@enduml
