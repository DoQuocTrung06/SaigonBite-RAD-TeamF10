@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontStyle bold
skinparam roundcorner 14
skinparam dpi 200
skinparam linetype ortho
hide empty description

skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #000000
skinparam StateBorderThickness 1.5
skinparam StateFontColor #000000
skinparam StateFontStyle bold

skinparam ArrowColor #000000
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11
skinparam ArrowFontStyle normal

skinparam nodesep 65
skinparam ranksep 60

right header 524H0031

state "Placed" as Placed
state "Confirmed" as Confirmed
state "Preparing" as Preparing
state "Ready" as Ready
state "Delivering" as Delivering
state "Delivered" as Delivered
state "Cancelled" as Cancelled
state "Failed" as Failed

' Top Row - Happy Path
[*] -right-> Placed : submitOrder
Placed -right-> Confirmed : confirmOrder [within SLA]
Confirmed -right-> Preparing : beginCooking
Preparing -right-> Ready : markOrderReady
Ready -right-> Delivering : pickUpOrder
Delivering -right-> Delivered : confirmDelivery [customer received]
Delivered -right-> [*] : archive

' Bottom Row - Failure / Exception Paths
Placed -down-> Cancelled : cancelOrder
Cancelled -right-> [*] : archive
Delivering -down-> Failed : failDelivery [customer unreachable]
Failed -right-> [*] : archive

@enduml
