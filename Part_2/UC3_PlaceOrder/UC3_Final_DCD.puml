@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 46
skinparam ranksep 46

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 10
skinparam ClassStereotypeFontColor #000000
skinparam ClassStereotypeFontSize 9

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000

hide circle
show members
top to bottom direction
right header 524H0031

class CheckoutWindow <<view>> {
  --
  +requestCheckout(basketItems): string
  +enterDeliveryAddress(deliveryAddress): string
  +applyVoucher(voucherCode): string
  +authorizeOnlinePayment(paymentDetails): string
  +submitOrder(paymentMethod): string
  +displayOrderReceipt(orderId, receipt, eta): void
}

class Customer {
  -customerId: string {key}
  -fullName: string
  -phoneNumber: string
  -emailAddress: string
  -dateRegistered: date
  --
}

class OrderHandler <<controller>> {
  --
  +requestCheckout(basketItems): string
  +enterDeliveryAddress(deliveryAddress): string
  +applyVoucher(voucherCode): currency
  +authorizeOnlinePayment(paymentDetails): string
  +submitOrder(paymentMethod): Order
}

class Hub {
  -hubId: string {key}
  -hubName: string
  -address: string
  -latitude: decimal
  -longitude: decimal
  -maxCapacityOrders: int
  -hubStatus: string
  --
  +verifyHubCapacity(basketItems): boolean
  +calculateDistance(deliveryAddress): decimal
  +checkQuietKitchenDiscount(): boolean
}

class HubDA <<dataAccess>> {
  --
  +readHubForItems(basketItems): Hub
}

class VoucherDA <<dataAccess>> {
  --
  +readVoucher(voucherCode): Voucher
  +updateVoucher(voucher): boolean
}

class Voucher {
  -voucherCode: string {key}
  -discountPercent: decimal
  -maxDiscountAmount: currency
  -minOrderAmount: currency
  -startDate: date
  -endDate: date
  -usageQuota: int
  -status: string
  --
  +calculateDiscount(voucherCode, subtotal): currency
  +redeemVoucher(): void
}

class Order {
  -orderId: string {key}
  -orderDateTime: date
  -orderStatus: string
  -deliveryAddress: string
  -distanceKm: decimal
  -subtotal: currency
  -deliveryFee: currency
  -discountAmount: currency
  -finalTotal: currency
  -paymentMethod: string
  --
  +addOrderLine(item, qty, notes): OrderLine
  +calculateSubtotal(): currency
  +calculateDeliveryAndTotal(address, distanceKm, quietEligible): currency
  +applyVoucherDiscount(voucherCode): currency
  +authorizePayment(paymentDetails): string
  +completeOrder(paymentMethod): string
}

class Payment {
  -paymentId: string {key}
  -paymentMethod: string
  -paymentAmount: currency
  -paymentStatus: string
  -authorizationCode: string
  -paymentDateTime: date
  --
  +authorizeOnlinePayment(paymentDetails, amount): string
  +recordPayment(paymentMethod, amount): Payment
}

class PaymentDA <<dataAccess>> {
  --
  +createPayment(payment): boolean
}

class KitchenTicket {
  -ticketId: string {key}
  -stationType: string
  -status: string
  -printedTime: date
  -completedTime: date
  --
  +createStationTicket(stationType): KitchenTicket
}

class OrderDA <<dataAccess>> {
  --
  +createOrder(order): string
}

class OrderLine {
  -quantity: int
  -itemPrice: currency
  -lineTotal: currency
  -specialNotes: string
  --
  +calculateLineTotal(item, qty): currency
}

class MenuItem {
  -itemId: string {key}
  -itemNameVi: string
  -itemNameEn: string
  -unitPrice: currency
  -stationType: string
  -status: string
  --
  +checkAvailability(): boolean
}

' Row 0 -> Row 1
CheckoutWindow -down-> OrderHandler

' Row 1: Customer <-- OrderHandler --> Hub --> HubDA
OrderHandler -left-> Customer
OrderHandler -right-> Hub
Hub -right-> HubDA

' Row 1 -> Row 2
Customer -down-> Order
OrderHandler -down-> Order
Hub -down-> Order

' Row 2: VoucherDA <-- Voucher <-- Order --> Payment --> PaymentDA
Order -left-> Voucher
Voucher -left-> VoucherDA
Order -right-> Payment
Payment -right-> PaymentDA

' Row 2 -> Row 3
Voucher -[hidden]down-> KitchenTicket
Order -down-> KitchenTicket
Order -down-> OrderDA
Order -down-> OrderLine
Payment -[hidden]down-> MenuItem

' Row 3: KitchenTicket   OrderDA   OrderLine --> MenuItem
KitchenTicket -[hidden]right-> OrderDA
OrderDA -[hidden]right-> OrderLine
OrderLine -right-> MenuItem

@enduml
