@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 145
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceBoxBorderColor #000000
skinparam SequenceBoxBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000
skinparam ParticipantFontSize 9

skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 9

right header 524H0031

actor "Customer" as Customer
participant "<<view>>\n__:Checkout__\n__Window__" as View
participant "<<controller>>\n__:Order__\n__Handler__" as Ctrl
participant "__aH:Hub__" as Hub
participant "<<dataAccess>>\n__:HubDA__" as HubDA
participant "__aO:Order__" as Order
participant "__aOL:OrderLine__" as OrderLine
participant "__aMI:MenuItem__" as MenuItem
participant "__aV:Voucher__" as Voucher
participant "<<dataAccess>>\n__:VoucherDA__" as VoucherDA
participant "__aP:Payment__" as Payment
participant "<<dataAccess>>\n__:PaymentDA__" as PaymentDA
participant "__aKT:Kitchen__\n__Ticket__" as Ticket
participant "<<dataAccess>>\n__:OrderDA__" as OrderDA

Customer -> View: requestCheckout(basketItems)
activate View
View -> Ctrl: requestCheckout(basketItems)
activate Ctrl
Ctrl -> Hub: verifyHubCapacity(basketItems)
activate Hub
Hub -> HubDA: readHubForItems(basketItems)
activate HubDA
HubDA --> Hub: aH
deactivate HubDA
Hub --> Ctrl: hubVerified
deactivate Hub
Ctrl -> Order: ~*[for each item] addOrderLine(item, qty, notes)
activate Order
Order -> OrderLine: calculateLineTotal(item, qty)
activate OrderLine
OrderLine -> MenuItem: checkAvailability()
activate MenuItem
MenuItem --> OrderLine: available
deactivate MenuItem
OrderLine --> Order: lineTotal
deactivate OrderLine
Order --> Ctrl: aOL
deactivate Order
Ctrl -> Order: calculateSubtotal()
activate Order
Order --> Ctrl: subtotal
deactivate Order
Ctrl --> View: checkout summary
deactivate Ctrl
View --> Customer: checkout summary
deactivate View

Customer -> View: enterDeliveryAddress(deliveryAddress)
activate View
View -> Ctrl: enterDeliveryAddress(deliveryAddress)
activate Ctrl
Ctrl -> Hub: calculateDistance(deliveryAddress)
activate Hub
Hub --> Ctrl: distanceKm
deactivate Hub
Ctrl -> Hub: checkQuietKitchenDiscount()
activate Hub
Hub --> Ctrl: quietDiscountEligible
deactivate Hub
Ctrl -> Order: calculateDeliveryAndTotal(deliveryAddress, distanceKm, quietDiscountEligible)
activate Order
Order --> Ctrl: priceSummary
deactivate Order
Ctrl --> View: distance, delivery fee, price summary
deactivate Ctrl
View --> Customer: distance, delivery fee, price summary
deactivate View

Customer -> View: [voucher code provided] applyVoucher(voucherCode)
activate View
View -> Ctrl: applyVoucher(voucherCode)
activate Ctrl
Ctrl -> Order: applyVoucherDiscount(voucherCode)
activate Order
Order -> Voucher: calculateDiscount(voucherCode, subtotal)
activate Voucher
Voucher -> VoucherDA: readVoucher(voucherCode)
activate VoucherDA
VoucherDA --> Voucher: aV
deactivate VoucherDA
Voucher --> Order: discountAmount
deactivate Voucher
Order --> Ctrl: updatedTotal
deactivate Order
Ctrl --> View: discount amount, updated total
deactivate Ctrl
View --> Customer: discount amount, updated total
deactivate View

Customer -> View: [online payment selected] authorizeOnlinePayment(paymentDetails)
activate View
View -> Ctrl: authorizeOnlinePayment(paymentDetails)
activate Ctrl
Ctrl -> Order: authorizePayment(paymentDetails)
activate Order
Order -> Payment: authorizeOnlinePayment(paymentDetails, finalTotal)
activate Payment
Payment --> Order: authorizationCode
deactivate Payment
Order --> Ctrl: paymentAuthorized
deactivate Order
Ctrl --> View: payment authorization
deactivate Ctrl
View --> Customer: payment authorization
deactivate View

Customer -> View: submitOrder(paymentMethod)
activate View
View -> Ctrl: submitOrder(paymentMethod)
activate Ctrl
Ctrl -> Order: completeOrder(paymentMethod)
activate Order
Order -> Payment: recordPayment(paymentMethod, finalTotal)
activate Payment
Payment -> PaymentDA: createPayment(aP)
activate PaymentDA
PaymentDA --> Payment: paymentSaved
deactivate PaymentDA
Payment --> Order: aP
deactivate Payment
Order -> Voucher: [voucher applied] redeemVoucher()
activate Voucher
Voucher -> VoucherDA: updateVoucher(aV)
activate VoucherDA
VoucherDA --> Voucher: voucherUpdated
deactivate VoucherDA
deactivate Voucher
Order -> Ticket: createStationTicket(stationType)
activate Ticket
Ticket --> Order: aKT
deactivate Ticket
Order -> OrderDA: createOrder(aO)
activate OrderDA
OrderDA --> Order: orderId
deactivate OrderDA
Order --> Ctrl: orderId, receipt, eta
deactivate Order
Ctrl --> View: order number, state Placed, receipt, ETA
deactivate Ctrl
View -> View: displayOrderReceipt(orderId, receipt, eta)
View --> Customer: order number, state Placed, receipt, ETA
deactivate View

@enduml
