@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam roundcorner 0
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 46
skinparam ranksep 46

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 10
skinparam ClassStereotypeFontColor #000000
skinparam ClassStereotypeFontSize 9

skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000

hide circle
show members
top to bottom direction
right header 524H0031

class Customer {
  -customerId: string {key}
  -fullName: string
  -phoneNumber: string
  -emailAddress: string
  -dateRegistered: date
  --
}

class OrderHandler <<controller>> {
  --
}

class Hub {
  -hubId: string {key}
  -hubName: string
  -address: string
  -latitude: decimal
  -longitude: decimal
  -maxCapacityOrders: int
  -hubStatus: string
  --
}

class Voucher {
  -voucherCode: string {key}
  -discountPercent: decimal
  -maxDiscountAmount: currency
  -minOrderAmount: currency
  -startDate: date
  -endDate: date
  -usageQuota: int
  -status: string
  --
}

class Order {
  -orderId: string {key}
  -orderDateTime: date
  -orderStatus: string
  -deliveryAddress: string
  -distanceKm: decimal
  -subtotal: currency
  -deliveryFee: currency
  -discountAmount: currency
  -finalTotal: currency
  -paymentMethod: string
  --
}

class Payment {
  -paymentId: string {key}
  -paymentMethod: string
  -paymentAmount: currency
  -paymentStatus: string
  -authorizationCode: string
  -paymentDateTime: date
  --
}

class KitchenTicket {
  -ticketId: string {key}
  -stationType: string
  -status: string
  -printedTime: date
  -completedTime: date
  --
}

class OrderLine {
  -quantity: int
  -itemPrice: currency
  -lineTotal: currency
  -specialNotes: string
  --
}

class MenuItem {
  -itemId: string {key}
  -itemNameVi: string
  -itemNameEn: string
  -unitPrice: currency
  -stationType: string
  -status: string
  --
}

' Row 1: Customer <-- OrderHandler --> Hub
OrderHandler -left-> Customer
OrderHandler -right-> Hub

' Vertical to Row 2
Customer -down-> Order
OrderHandler -down-> Order
Hub -down-> Order

' Row 2: Voucher <-- Order --> Payment
Order -left-> Voucher
Order -right-> Payment

' Vertical to Row 3
Voucher -[hidden]down-> KitchenTicket
Order -down-> KitchenTicket
Order -down-> OrderLine
Payment -[hidden]down-> MenuItem

' Row 3: KitchenTicket   OrderLine --> MenuItem
KitchenTicket -[hidden]right-> OrderLine
OrderLine -right-> MenuItem

@enduml
