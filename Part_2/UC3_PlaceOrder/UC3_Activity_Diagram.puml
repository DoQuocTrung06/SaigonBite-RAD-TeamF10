@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 5
skinparam shadowing false
skinparam dpi 160

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.3
skinparam ActivityFontColor #000000
skinparam ActivityPadding 11
skinparam ActivityMargin 6

skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBorderThickness 1.3
skinparam ActivityDiamondFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 11

skinparam partition {
  BorderColor #000000
  BorderThickness 1.3
  FontColor #000000
  FontSize 13
  FontStyle bold
  BackgroundColor #FFFFFF
}

skinparam RankSep 44
skinparam NodeSep 55

right header 524H0031

|Customer|
|SaigonBite System|

|Customer|
start
:Select menu items;
:Proceed to checkout;

|SaigonBite System|
:Verify single-hub constraint;
if (All items in same hub?) then ([Yes])
  :Display checkout screen;
else ([No])
  :Display cross-hub conflict error;
  stop
endif

|Customer|
:Enter delivery address;

|SaigonBite System|
:Calculate delivery distance;
if (Distance <= 7.0 km?) then ([Yes])
  :Compute delivery fee;
else ([No])
  :Display radius exceeded error;
  stop
endif

|Customer|
:Enter voucher code (if any);

|SaigonBite System|
if (Voucher code entered?) then ([Yes])
  :Validate voucher;
  if (Voucher valid?) then ([Yes])
    :Apply voucher discount;
  else ([No])
    :Display invalid voucher message;
  endif
else ([No])
endif

if (Kitchen load < 40%?) then ([Yes])
  :Apply Quiet-Kitchen discount;
else ([No])
endif

:Calculate total payable amount;
:Display order summary;

|Customer|
:Select payment method;
:Submit order;

|SaigonBite System|
if (Payment method?) then ([Cash on Delivery])
  :Record payment as unpaid;
else ([Online Payment])
  :Authorize online payment;
  if (Payment authorized?) then ([Yes])
    :Record payment as paid;
  else ([No])
    :Display payment failure message;
    stop
  endif
endif

:Create order with state Placed;
:Queue order for hub kitchen;
:Send order confirmation and ETA;

|Customer|
:Receive order confirmation;
stop

@enduml
