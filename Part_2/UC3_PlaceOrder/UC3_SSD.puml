@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 0
skinparam dpi 200
hide footbox

skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBorderThickness 1.2
skinparam ParticipantFontColor #000000

skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 10

skinparam GroupBackgroundColor #FFFFFF
skinparam GroupBorderColor #000000
skinparam GroupBorderThickness 1.0
skinparam GroupFontColor #000000
skinparam GroupHeaderFontColor #000000

right header 524H0031

actor "Customer" as Customer
participant "__:System__" as System

Customer -> System: requestCheckout(basketItems)
System --> Customer: checkout summary

Customer -> System: enterDeliveryAddress(deliveryAddress)
System --> Customer: distance, delivery fee, price summary

opt voucher code provided
  Customer -> System: applyVoucher(voucherCode)
  System --> Customer: discount amount, updated total
end

opt online payment selected
  Customer -> System: authorizeOnlinePayment(paymentDetails)
  System --> Customer: payment authorization
end

Customer -> System: submitOrder(paymentMethod)
System --> Customer: order number, state Placed, receipt, ETA

@enduml
