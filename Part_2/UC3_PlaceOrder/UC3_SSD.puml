@startuml
skinparam monochrome true
title UC3: Place an Order - System Sequence Diagram (SSD)
actor "Customer" as Customer
participant ":SaigonBiteSystem" as System

Customer -> System: viewMultiBrandCart(hubId, cartItems)
System --> Customer: displayCartSummary(subtotal, hubVerified)

Customer -> System: applyVoucher(voucherCode)
System --> Customer: returnDiscountedTotal(discountAmount, finalTotal)

Customer -> System: submitOrderCheckout(deliveryAddress, paymentMethod)
System --> Customer: orderPlacedConfirmation(orderId, estimatedTime)
@enduml
